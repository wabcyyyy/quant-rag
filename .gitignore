# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# 环境变量
.env

# 公司语料与解析产物——严禁入库（合规，见 PLAN §8）
data/raw/*
data/parsed/*
!data/raw/.gitkeep
!data/parsed/.gitkeep
# 示例语料的解析产物不入库（示例 PDF 本体 data/sample_raw/ 入库）
data/sample_parsed/
# 评估黄金集含公司内容，默认不入库；如需版本管理放私有仓
data/eval/*.json
# 例外：脱敏合成的格式模板（虚构公司内容，不含真实语料），见 README
!data/eval/golden_sample.json

# 工具缓存
.pytest_cache/
.pytest_tmp/
.ruff_cache/
.ipynb_checkpoints/

# LLM 响应缓存（本地，可随时删除）
.cache/

# 面试准备（个人求职叙事）——只留本地，不入库不上传（README 保持纯工程文档）
docs/

# ZCode 会话产物
.zcode/
