# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/

# 环境变量
.env

# 公司语料与解析产物——严禁入库（合规，见 docs/design/PLAN.md §8）
data/raw/*
data/parsed/*
!data/raw/.gitkeep
!data/parsed/.gitkeep
# 示例语料的解析产物不入库（示例 PDF 本体 data/sample_raw/ 入库）
data/sample_parsed/
# 评估黄金集含公司内容，默认不入库；如需版本管理放私有仓
data/eval/*.json
# 例外：脱敏合成的格式模板（虚构公司内容，不含真实语料），见 README
!data/eval/golden_sample.json
# 例外：查询改写的泛化门禁集（全部指向 data/sample_raw 的虚构语料）
!data/eval/rewrite_paraphrase.json

# 工具缓存
.pytest_cache/
.pytest_tmp/
.ruff_cache/
.ipynb_checkpoints/

# LLM 响应缓存（本地，可随时删除）
.cache/

# docs/ 默认本地；工程文档白名单入库
# 写法说明：!docs/ 救不回被 docs/** 忽略的子路径，必须逐级放行目录
docs/**
!docs/README.md
!docs/architecture/
!docs/architecture/**
!docs/design/
!docs/design/**
!docs/guides/
!docs/guides/**
# 下列仍保持本地不入库：夜间执行记录、个人面试材料
# docs/ops/** 与 docs/personal/** 未加入白名单

# ZCode 会话产物
.zcode/
