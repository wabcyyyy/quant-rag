# 复制为 .env 并填写（.env 已被 gitignore，严禁提交）
#
# LLM：DeepSeek 官方 API（platform.deepseek.com → API Keys 新建）
#   deepseek-v4-pro = 旗舰正式版（默认：合成 + RAGAS judge，成熟稳定，
#                     官方确认长期服务、折扣永久）
#   deepseek-flash  = V4.1-Flash（2026-09-10 发布，更便宜；要换就改下面一行）
#   注意：不要用旧别名 deepseek-chat / deepseek-reasoner（停用过渡期，指向不稳）
#
# Embedding：SiliconFlow（DeepSeek 官方无 embedding API）
#   BAAI/bge-m3，只返回 dense（hybrid 第二路走 Qdrant full-text BM25，见 PLAN §5.2）
#
# 模型名以官方文档为准：api-docs.deepseek.com / docs.siliconflow.cn

DOC_RAG_LLM_BASE_URL=https://api.deepseek.com/v1
DOC_RAG_LLM_API_KEY=
DOC_RAG_LLM_MODEL=deepseek-v4-pro

DOC_RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
DOC_RAG_EMBEDDING_API_KEY=
