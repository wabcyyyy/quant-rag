# 复制为 .env 并填写（.env 已被 gitignore，严禁提交）
#
# ── LLM：DeepSeek 官方（platform.deepseek.com → API Keys）───────────────────
#   实测选定的模型（见 PLAN「模型选型」）：包含匹配 0.836 vs GLM-4.5-Air 0.745，
#   价差被本地响应缓存抵消（同配置重跑命中约 90%，不重复付费）。
#   注意：
#   1) `deepseek-flash` 是**推理型模型**：输出里 91% 是看不见的 reasoning token。
#      max_tokens 给小了 content 会是 None（check 已按 512 处理并显式提示）；
#      这也是端到端延迟的主因（聚合题 p50 24~32s，见 PLAN「延迟实测」）。
#   2) 压延迟：设 DOC_RAG_LLM_REASONING_EFFORT=none 关掉合成侧思考
#      （延迟降 13×，代价是包含匹配 −10.9pt，属产品取舍，默认不设）。
#   3) 换模型后 RAGAS 指标与旧基线不可直接比较（PLAN §5.3 口径）。
#
#   备选（更便宜但质量低 9pt）：SiliconFlow 的 zai-org/GLM-4.5-Air。
#   不推荐：OpenRouter 免费档——限 50 请求/天，62 条评估跑不完（PLAN §8）；
#   且免费档通常要求开启「允许用于训练/日志」，公司文档出域前先确认合规。
#
# ── Embedding / Rerank：SiliconFlow（OpenRouter 不提供这两类接口）───────────
#   BAAI/bge-m3（dense，1024 维）+ BAAI/bge-reranker-v2-m3

DOC_RAG_LLM_BASE_URL=https://api.deepseek.com
DOC_RAG_LLM_API_KEY=
DOC_RAG_LLM_MODEL=deepseek-flash
# 合成侧思考开关：留空=开思考（质量优先，当前默认）；设 none 压延迟
DOC_RAG_LLM_REASONING_EFFORT=
# 分题型档位在 configs/default.yaml 的 `llm.reasoning_effort_by_type`（不在这里）：
# 默认 cross_doc / time_filter = none（聚合题关思考，实测两项质量指标均无损失而
# 端到端 24~32s → 2s），其余题型跟随上面的全局值。值写字面量而不是 env 间接，
# 是为了「裸检出也必须拿到分流」——旧键 DOC_RAG_LLM_REASONING_EFFORT_AGGREGATE 已废弃，
# 设了会被 load_config 警告（它不再被读取，别以为分流还由它控制）。

DOC_RAG_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
DOC_RAG_EMBEDDING_API_KEY=

# ── 判分（RAGAS judge / 拒答审计）可与生成不同源 ─────────────────────────────
#   全部留空 = judge 继承上面的 LLM（默认，同源判分）。现有 Faithfulness 基线都是
#   同源判出来的；换 judge 就是**换度量身份**，跨 judge 的绝对分数不能并列引用。
#   用途：回答「换个 judge 结论会不会翻」（PLAN §5.3「judge 自偏」，已实测零翻转）。
#   只指向 embedding 那家（SiliconFlow）时 API Key 可留空——同账号复用，少一处密钥落地。
DOC_RAG_JUDGE_BASE_URL=
DOC_RAG_JUDGE_API_KEY=
DOC_RAG_JUDGE_MODEL=

# FastAPI 鉴权令牌：/query 与 /query/stream 要求 Authorization: Bearer <token>。
# 留空 = 两个端点一律 503（拒绝服务，而不是裸奔到公网上）。
# 允许被查询的 collection 白名单在 configs/default.yaml 的 api.allowed_collections。
DOC_RAG_API_TOKEN=
